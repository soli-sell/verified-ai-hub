const resend = new Resend(process.env.RESEND_API_KEY);

export async function POST(req: Request) {
  try {
    const body = await req.json();
    const { name, email, message } = body;

    const data = await resend.emails.send({
      from: 'VerifiedAIHub <onboarding@resend.dev>',
      to: 'support@verifiedaihub.com',
      replyTo: email,
      subject: `New Enterprise Inquiry from ${name || 'Website User'}`,
      text: `Name: ${name}\nEmail: ${email}\n\nMessage:\n${message}`,
    });

    if (data.error) {
      console.error('Resend API Returned Error:', data.error);
      return Response.json({ success: false, error: data.error }, { status: 400 });
    }

    return Response.json({ success: true, data });
  } catch (error: any) {
    console.error('Server Error:', error);
    return Response.json({ success: false, error: error.message || String(error) }, { status: 500 });
  }
}
